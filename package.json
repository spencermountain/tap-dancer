{
  "name": "tap-dancer",
  "version": "0.4.1",
  "description": "a quick human-readable test-reporter for Tap",
  "license": "MIT",
  "repository": "github:spencermountain/tap-dancer",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "tap-dancer": "./src/cli.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "pnpm --dir integration/tape test",
    "watch": "node ./scratch.js",
    "lint": "eslint ."
  },
  "files": [
    "changelog.md",
    "src"
  ],
  "keywords": [
    "reporter",
    "tap",
    "tape"
  ],
  "dependencies": {
    "tap-parser": "^18.3.4"
  }
}
